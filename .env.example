# Copy this file to .env and fill in the three LLM lines.
# .env is git-ignored. Do not put the real key in this example file.

# OpenAI-compatible base URL. Groq: https://api.groq.com/openai/v1
# xAI: https://api.x.ai/v1
LLM_BASE_URL=

# Secret. The app reads this name, not OPENAI_API_KEY.
LLM_API_KEY=

# Model id from that provider's model list. Do not hard-code it in Python.
LLM_MODEL=

# The process listens on this port. Deployment must use the same value.
PORT=8000

# Karim reviews other agents when this is true.
ENABLE_AUDITOR=true

# Share of retail price reserved for shipping, fees, ads, and returns.
COST_ALLOWANCE=0.40
